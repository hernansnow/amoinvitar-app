{
  "name": "amoinvitar-app",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "node scripts/servidor-local.mjs",
    "estilos": "node scripts/convertir-estilos.mjs",
    "sitio": "node scripts/archivos-modelos.mjs && node scripts/sitio/construir.mjs",
    "sitio:i18n": "node scripts/sitio/i18n-pendientes.mjs",
    "panel:i18n": "node scripts/sitio/i18n-panel.mjs",
    "sitio:mini": "node scripts/sitio/hero-mini.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply amoinvitar --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply amoinvitar --local"
  },
  "dependencies": {
    "linkedom": "0.18.12",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "purgecss": "^8.0.0",
    "wrangler": "^4.158.0"
  }
}
